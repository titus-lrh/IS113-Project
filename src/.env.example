# MongoDB Configuration
# For local development: mongodb://localhost:27017/is113_db
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database_name?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/is113_db

# Server Configuration
PORT=8000
NODE_ENV=development

# Session Secret (change this to a random string for production)
SESSION_SECRET=your_secret_key_change_this_in_production

# Database Name
DB_NAME=is113_db

# You can add more config variables here as needed
# Example:
# JWT_SECRET=your_jwt_secret
# API_KEY=your_api_key
