<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Schedule — Everyday Cooks</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- NAV -->
  <nav class="nav">
    <a href="/" class="nav__brand">Everyday Cooks</a>
    <div class="nav__links">
      <a href="/recipes" class="nav__link">Recipes</a>
      <a href="/schedule" class="nav__link nav__link--active">Schedule</a>
      <% if (session && session.userId) { %>
        <span class="nav__user"><%= session.username %></span>
        <a href="/auth/dashboard" class="nav__link">Dashboard</a>
        <a href="/auth/logout" class="nav__link">Logout</a>
      <% } %>
    </div>
  </nav>

  <div class="container container--xl">

    <!-- MACRO BAR -->
    <div id="macrobar-region">
      <%- include('./_macrobar', { dailyTotals: log.dailyTotals, calorieGoal: calorieGoal }) %>
    </div>

    <!-- SUGGESTIONS -->
    <%- include('./_suggestions', { suggestions: suggestions || [], remainingCalories: remainingCalories || 0, dateString }) %>

    <!-- DATE NAVIGATOR -->
    <%
      const today     = new Date().toISOString().slice(0, 10);
      const current   = new Date(dateString + 'T00:00:00Z');
      const prevDate  = new Date(current); prevDate.setUTCDate(prevDate.getUTCDate() - 1);
      const nextDate  = new Date(current); nextDate.setUTCDate(nextDate.getUTCDate() + 1);
      const prevStr   = prevDate.toISOString().slice(0, 10);
      const nextStr   = nextDate.toISOString().slice(0, 10);
      const isToday   = dateString === today;
      const displayLabel = isToday
        ? 'Today'
        : current.toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric', timeZone: 'UTC' });
    %>
    <div class="date-nav">
      <a href="/schedule/<%= prevStr %>" class="date-nav__arrow" aria-label="Previous day">&#8249;</a>
      <span class="date-nav__label"><%= displayLabel %></span>
      <a href="/schedule/<%= nextStr %>" class="date-nav__arrow" aria-label="Next day">&#8250;</a>
    </div>

    <!-- TIMELINE -->
    <div id="timeline-region">
      <%
        const MEAL_ORDER = ['Breakfast','Morning Snack','Lunch','Afternoon Snack','Dinner','Evening Snack','Other'];
        const grouped = {};
        MEAL_ORDER.forEach(m => { grouped[m] = []; });
        (log.entries || []).forEach(e => {
          const key = e.mealType || 'Other';
          if (!grouped[key]) grouped[key] = [];
          grouped[key].push(e);
        });
      %>

      <% MEAL_ORDER.forEach(mealType => { %>
        <div class="meal-group" data-meal="<%= mealType %>">
          <div class="meal-group__header">
            <span class="meal-group__title"><%= mealType %></span>
            <%
              const groupTotals = grouped[mealType].reduce((acc, e) => {
                if (e.computed) {
                  acc.calories += e.computed.calories || 0;
                }
                return acc;
              }, { calories: 0 });
            %>
            <% if (grouped[mealType].length > 0) { %>
              <span class="meal-group__cal"><%= Math.round(groupTotals.calories) %> kcal</span>
            <% } %>
          </div>

          <div class="meal-group__entries">
            <% grouped[mealType].forEach(entry => { %>
              <%- include('./_entry', { entry, dateString }) %>
            <% }); %>
          </div>

          <!-- Add food form -->
          <div class="add-food-row" data-meal="<%= mealType %>">
            <form method="POST" action="/schedule/search-food" class="add-food-form" style="display: block;">
              <input
                type="text"
                name="query"
                class="input input--sm"
                placeholder="Search and add food…"
                required
                style="display: block; width: 100%; margin-bottom: 8px;"
              >
              <input type="hidden" name="mealType" value="<%= mealType %>">
              <input type="hidden" name="dateString" value="<%= dateString %>">
              <button type="submit" class="btn btn--ghost btn--sm">+ Add to <%= mealType %></button>
            </form>
          </div>
        </div>
      <% }); %>
    </div>

  </div>

</body>
</html>
