<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Recipes - Recipe App</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background-color: #f5f5f5;
      color: #333;
    }

    nav {
      background-color: #333;
      padding: 1rem 2rem;
      color: white;
      display: flex;
      justify-content: space-between;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 1.5rem;
    }

    nav a:hover {
      text-decoration: underline;
    }

    .container {
      max-width: 1200px;
      margin: 2rem auto;
      padding: 0 1rem;
    }

    h1 {
      margin-bottom: 2rem;
    }

    .filters {
      margin-bottom: 2rem;
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .filters a {
      display: inline-block;
      padding: 0.5rem 1rem;
      background-color: #667eea;
      color: white;
      text-decoration: none;
      border-radius: 0.25rem;
    }

    .filters a:hover {
      background-color: #5568d3;
    }

    .recipes-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 2rem;
    }

    .recipe-card {
      background-color: white;
      border-radius: 0.5rem;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      overflow: hidden;
      transition: transform 0.3s;
    }

    .recipe-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
    }

    .recipe-header {
      padding: 1.5rem;
      background-color: #f9f9f9;
      border-bottom: 1px solid #eee;
    }

    .recipe-header h3 {
      margin-bottom: 0.5rem;
    }

    .recipe-meta {
      font-size: 0.9rem;
      color: #666;
    }

    .recipe-body {
      padding: 1.5rem;
    }

    .recipe-body p {
      color: #666;
      margin-bottom: 1rem;
      line-height: 1.5;
    }

    .recipe-info {
      display: flex;
      justify-content: space-around;
      margin: 1rem 0;
      padding: 1rem 0;
      border-top: 1px solid #eee;
      border-bottom: 1px solid #eee;
    }

    .info-item {
      text-align: center;
    }

    .info-item strong {
      display: block;
      color: #667eea;
    }

    .recipe-footer {
      padding: 1.5rem;
      background-color: #f9f9f9;
      display: flex;
      gap: 1rem;
    }

    .recipe-footer a {
      flex: 1;
      display: block;
      padding: 0.75rem;
      text-align: center;
      text-decoration: none;
      border-radius: 0.25rem;
      background-color: #667eea;
      color: white;
    }

    .recipe-footer a:hover {
      background-color: #5568d3;
    }

    .empty-state {
      text-align: center;
      padding: 3rem;
      background-color: white;
      border-radius: 0.5rem;
    }

    .empty-state h2 {
      margin-bottom: 1rem;
    }

    .empty-state a {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background-color: #667eea;
      color: white;
      text-decoration: none;
      border-radius: 0.25rem;
      margin-top: 1rem;
    }

    .empty-state a:hover {
      background-color: #5568d3;
    }

    .category-badge {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      background-color: #e0e7ff;
      color: #667eea;
      border-radius: 1rem;
      font-size: 0.85rem;
    }
  </style>
</head>
<body>
  <nav>
    <strong>Recipe App</strong>
    <div>
      <% if (typeof session !== 'undefined' && session.userId) { %>
        <span><%= session.username %></span>
        <a href="/recipes/new">Create Recipe</a>
        <a href="/dashboard">Dashboard</a>
        <a href="/auth/logout">Logout</a>
      <% } else { %>
        <a href="/login">Login</a>
        <a href="/register">Register</a>
      <% } %>
    </div>
  </nav>

  <div class="container">
    <h1>Recipes</h1>

    <% if (typeof category !== 'undefined' && category) { %>
      <p>Showing recipes in category: <strong><%= category %></strong></p>
    <% } %>

    <% if (typeof recipes !== 'undefined' && recipes.length > 0) { %>
      <div class="recipes-grid">
        <% recipes.forEach(recipe => { %>
          <div class="recipe-card">
            <div class="recipe-header">
              <h3><%= recipe.title %></h3>
              <div class="recipe-meta">
                By <%= recipe.author.username %>
              </div>
            </div>

            <div class="recipe-body">
              <p><%= recipe.description.substring(0, 100) %>...</p>

              <% if (recipe.category) { %>
                <span class="category-badge"><%= recipe.category %></span>
              <% } %>

              <div class="recipe-info">
                <div class="info-item">
                  <strong><%= recipe.cookingTime %></strong>
                  <small>minutes</small>
                </div>
                <div class="info-item">
                  <strong><%= recipe.servings %></strong>
                  <small>servings</small>
                </div>
                <div class="info-item">
                  <strong><%= recipe.ingredients.length %></strong>
                  <small>ingredients</small>
                </div>
              </div>
            </div>

            <div class="recipe-footer">
              <a href="/recipes/<%= recipe._id %>">View</a>
              <% if (typeof session !== 'undefined' && session.userId && recipe.author._id == session.userId) { %>
                <a href="/recipes/<%= recipe._id %>/edit">Edit</a>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <h2>No recipes found</h2>
        <p>There are no recipes in this category yet.</p>
        <% if (typeof session !== 'undefined' && session.userId) { %>
          <a href="/recipes/new">Create the first recipe</a>
        <% } else { %>
          <p><a href="/register">Register</a> to create a recipe</p>
        <% } %>
      </div>
    <% } %>
  </div>
</body>
</html>
