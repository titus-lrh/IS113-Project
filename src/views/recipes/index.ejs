<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Recipes - Everyday Cooks</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background-color: #f5f5f5;
      color: #333;
    }

    nav {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      padding: 1rem 2rem;
      color: white;
      display: flex;
      justify-content: space-between;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 1.5rem;
    }

    nav a:hover {
      text-decoration: underline;
    }

    .container {
      max-width: 1200px;
      margin: 2rem auto;
      padding: 0 1rem;
    }

    h1 {
      margin-bottom: 2rem;
    }

    .search-bar {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 2rem;
    }

    .search-bar input {
      flex: 1;
      padding: 0.65rem 1rem;
      border: 1px solid #ddd;
      border-radius: 0.25rem;
      font-size: 1rem;
    }

    .search-bar button {
      padding: 0.65rem 1.5rem;
      background-color: #667eea;
      color: white;
      border: none;
      border-radius: 0.25rem;
      font-size: 1rem;
      cursor: pointer;
    }

    .search-bar button:hover {
      background-color: #5568d3;
    }

    .section-title {
      margin: 2rem 0 1rem;
      font-size: 1.4rem;
      color: #333;
      border-left: 4px solid #667eea;
      padding-left: 0.75rem;
    }

    .recipes-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 2rem;
    }

    .recipe-card {
      background-color: white;
      border-radius: 0.5rem;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      overflow: hidden;
      transition: transform 0.3s;
      display: flex;
      flex-direction: column;
      height: 400px;
    }

   .recipe-header {
    padding: 1.5rem;
    background-color: #f9f9f9;
    border-bottom: 1px solid #eee;
    height: 80px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

    .recipe-header h3 {
      margin-bottom: 0.5rem;
    }

    .recipe-meta {
      font-size: 0.9rem;
      color: #666;
    }

    .recipe-body {
      padding: 1.5rem;
      flex: 1;
    }

    .recipe-body p {
      color: #666;
      margin-bottom: 1rem;
      line-height: 1.5;
    }

    .recipe-info {
      display: flex;
      justify-content: space-around;
      margin: 1rem 0;
      padding: 1rem 0;
      border-top: 1px solid #eee;
      border-bottom: 1px solid #eee;
    }

    .info-item {
      text-align: center;
    }

    .info-item strong {
      display: block;
      color: #667eea;
    }

  .recipe-footer {
    padding: 1.5rem;
    background-color: #f9f9f9;
    display: flex;
    gap: 1rem;
    flex-shrink: 0;
    margin-top: auto;
  }

    .recipe-footer a {
      flex: 1;
      display: block;
      padding: 0.75rem;
      text-align: center;
      text-decoration: none;
      border-radius: 0.25rem;
      background-color: #667eea;
      color: white;
    }

    .recipe-footer a:hover {
      background-color: #5568d3;
    }

    .empty-state {
      text-align: center;
      padding: 3rem;
      background-color: white;
      border-radius: 0.5rem;
    }

    .empty-state h2 {
      margin-bottom: 1rem;
    }

    .empty-state a {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background-color: #667eea;
      color: white;
      text-decoration: none;
      border-radius: 0.25rem;
      margin-top: 1rem;
    }

    .empty-state a:hover {
      background-color: #5568d3;
    }

    .category-badge {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      background-color: #e0e7ff;
      color: #667eea;
      border-radius: 1rem;
      font-size: 0.85rem;
    }

    .recipe-description {
      height: 60px;
    }

    .mealdb-card {
      background-color: white;
      border-radius: 0.5rem;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      overflow: hidden;
      transition: transform 0.3s;
      display: flex;
      flex-direction: column;
    }

    .mealdb-card:hover {
      transform: translateY(-4px);
    }

    .mealdb-thumb {
      width: 100%;
      height: 180px;
      object-fit: cover;
    }

    .mealdb-body {
      padding: 1rem;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .mealdb-body h3 {
      font-size: 1rem;
      margin-bottom: 0.75rem;
    }

    .mealdb-body a {
      display: block;
      padding: 0.5rem;
      text-align: center;
      background-color: #667eea;
      color: white;
      text-decoration: none;
      border-radius: 0.25rem;
      font-size: 0.9rem;
    }

    .mealdb-body a:hover {
      background-color: #5568d3;
    }

    .source-badge {
      display: inline-block;
      padding: 0.15rem 0.6rem;
      background-color: #fef3c7;
      color: #92400e;
      border-radius: 1rem;
      font-size: 0.8rem;
      margin-bottom: 0.5rem;
    }
  </style>
</head>
<body>
  <nav>
    <strong>Everyday Cooks</strong>
    <div>
      <% if (typeof session !== 'undefined' && session.userId) { %>
        <span><%= session.username %></span>
        <a href="/recipes/new">Create Recipe</a>
        <a href="/auth/dashboard">Dashboard</a>
        <a href="/auth/logout">Logout</a>
      <% } else { %>
        <a href="/auth/login">Login</a>
      <% } %>
    </div>
  </nav>

  <div class="container">
    <h1>All Recipes</h1>

    <form class="search-bar" action="/recipes/search" method="GET">
      <input type="text" name="q" placeholder="Search user and stock recipes...">
      <button type="submit">Search</button>
    </form>

    <h2 class="section-title">User Recipes</h2>
    <% if (typeof recipes !== 'undefined' && recipes.length > 0) { %>
      <div class="recipes-grid">
        <% recipes.forEach(recipe => { %>
          <div class="recipe-card">
            <div class="recipe-header">
              <h3><%= recipe.title %></h3>
              <div class="recipe-meta">
                By <%= recipe.author.username %>
              </div>
            </div>

            <div class="recipe-body">
              <div class="recipe-description">
                <p><%= recipe.description.substring(0, 100) %>...</p>
              </div>
              <% if (recipe.category) { %>
                <span class="category-badge"><%= recipe.category %></span>
              <% } %>
            </div>
              <div class="recipe-info">
                <div class="info-item">
                  <strong><%= recipe.cookingTime %></strong>
                  <small>minutes</small>
                </div>
                <div class="info-item">
                  <strong><%= recipe.servings %></strong>
                  <small>servings</small>
                </div>
                <div class="info-item">
                  <strong><%= recipe.ingredients.length %></strong>
                  <small>ingredients</small>
                </div>
              </div>

            <div class="recipe-footer">
              <a href="/recipes/<%= recipe._id %>">View</a>
              <% if (typeof session !== 'undefined' && session.userId && recipe.author._id == session.userId) { %>
                <a href="/recipes/<%= recipe._id %>/edit">Edit</a>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <h2>No user recipes yet</h2>
        <% if (typeof session !== 'undefined' && session.userId) { %>
          <a href="/recipes/new">Create the first recipe</a>
        <% } else { %>
          <p><a href="/auth/register">Register</a> to create a recipe</p>
        <% } %>
      </div>
    <% } %>

    <h2 class="section-title">Stock Recipes</h2>
    <% if (typeof mealdbRecipes !== 'undefined' && mealdbRecipes.length > 0) { %>
      <div class="recipes-grid">
        <% mealdbRecipes.forEach(meal => { %>
          <div class="mealdb-card">
            <img class="mealdb-thumb" src="<%= meal.strMealThumb %>" alt="<%= meal.strMeal %>">
            <div class="mealdb-body">
              <div>
                <span class="source-badge">TheMealDB</span>
                <h3><%= meal.strMeal %></h3>
              </div>
              <a href="/recipes/mealdb/<%= meal.idMeal %>">View Recipe</a>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <p style="color: #888;">No stock recipes available right now.</p>
    <% } %>
  </div>
</body>
</html>
