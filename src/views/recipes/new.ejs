<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Recipe - Everyday Cooks</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background-color: #f5f5f5;
      color: #333;
    }

    nav {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      padding: 1rem 2rem;
      color: white;
      display: flex;
      justify-content: space-between;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 1.5rem;
    }

    nav a:hover {
      text-decoration: underline;
    }

    .container {
      max-width: 800px;
      margin: 2rem auto;
      padding: 0 1rem;
    }

    h1 {
      margin-bottom: 2rem;
    }

    form {
      background-color: white;
      padding: 2rem;
      border-radius: 0.5rem;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    .error {
      background-color: #f8d7da;
      color: #721c24;
      padding: 0.75rem 1.25rem;
      border-radius: 0.25rem;
      margin-bottom: 1rem;
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    label {
      display: block;
      margin-bottom: 0.5rem;
      font-weight: bold;
      color: #333;
    }

    input,
    textarea,
    select {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid #ddd;
      border-radius: 0.25rem;
      font-size: 1rem;
      font-family: Arial, sans-serif;
    }

    input:focus,
    textarea:focus,
    select:focus {
      outline: none;
      border-color: #667eea;
      box-shadow: 0 0 5px rgba(102, 126, 234, 0.3);
    }

    textarea {
      resize: vertical;
      min-height: 150px;
    }

    .form-hint {
      font-size: 0.85rem;
      color: #666;
      margin-top: 0.25rem;
    }

    .button-group {
      display: flex;
      gap: 1rem;
      margin-top: 2rem;
    }

    button,
    .btn-cancel {
      flex: 1;
      padding: 0.75rem;
      border: none;
      border-radius: 0.25rem;
      cursor: pointer;
      font-size: 1rem;
      font-weight: bold;
      text-decoration: none;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .btn-submit {
      background-color: #667eea;
      color: white;
    }

    .btn-submit:hover {
      background-color: #5568d3;
    }

    .btn-cancel {
      background-color: #6c757d;
      color: white;
    }

    .btn-cancel:hover {
      background-color: #5a6268;
    }

    .two-column {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }


    .info-box {
      background-color: #e8f4f8;
      border-left: 4px solid #667eea;
      padding: 1rem;
      margin-bottom: 1.5rem;
      border-radius: 0.25rem;
    }

    .info-box strong {
      display: block;
      margin-bottom: 0.5rem;
    }
  </style>
</head>
<body>
  <nav>
    <strong>Everyday Cooks</strong>
    <div>
      <a href="/recipes">Recipes</a>
      <a href="/auth/dashboard">Dashboard</a>
      <a href="/auth/logout">Logout</a>
    </div>
  </nav>

  <div class="container">
    <h1>Create New Recipe</h1>

    <div class="info-box">
      <strong>📝 Tips:</strong>
      Fill in all fields below to create your recipe. Be detailed in the instructions!
    </div>

    <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
      <% errors.forEach(error => { %>
        <div class="error"><%= error.msg %></div>
      <% }); %>
    <% } %>

    <form method="POST" action="/recipes">
      <div class="form-group">
        <label for="title">Recipe Title</label>
        <input
          type="text"
          id="title"
          name="title"
          placeholder="e.g., Classic Chocolate Chip Cookies"
          value="<%= typeof body !== 'undefined' ? body.title || '' : '' %>"
          required
        >
        <div class="form-hint">Give your recipe a clear, descriptive name</div>
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <textarea
          id="description"
          name="description"
          placeholder="Describe your recipe in a few sentences..."
          required
        ><%= typeof body !== 'undefined' ? body.description || '' : '' %></textarea>
        <div class="form-hint">Tell people what makes this recipe special</div>
      </div>

      <div class="two-column">
        <div class="form-group">
          <label for="cookingTime">Cooking Time (minutes)</label>
          <input
            type="number"
            id="cookingTime"
            name="cookingTime"
            min="1"
            placeholder="30"
            value="<%= typeof body !== 'undefined' ? body.cookingTime || '' : '' %>"
            required
          >
        </div>

        <div class="form-group">
          <label for="servings">Number of Servings</label>
          <input
            type="number"
            id="servings"
            name="servings"
            min="1"
            placeholder="4"
            value="<%= typeof body !== 'undefined' ? body.servings || '' : '' %>"
            required
          >
        </div>
      </div>

      <div class="form-group">
        <label for="category">Category</label>
        <select id="category" name="category" required>
          <option value="">Select a category</option>
          <option value="vegan" <%= typeof body !== 'undefined' && body.category === 'vegan' ? 'selected' : '' %>>Vegan</option>
          <option value="dessert" <%= typeof body !== 'undefined' && body.category === 'dessert' ? 'selected' : '' %>>Dessert</option>
          <option value="quick-meals" <%= typeof body !== 'undefined' && body.category === 'quick-meals' ? 'selected' : '' %>>Quick Meals</option>
          <option value="breakfast" <%= typeof body !== 'undefined' && body.category === 'breakfast' ? 'selected' : '' %>>Breakfast</option>
          <option value="lunch" <%= typeof body !== 'undefined' && body.category === 'lunch' ? 'selected' : '' %>>Lunch</option>
          <option value="dinner" <%= typeof body !== 'undefined' && body.category === 'dinner' ? 'selected' : '' %>>Dinner</option>
          <option value="snack" <%= typeof body !== 'undefined' && body.category === 'snack' ? 'selected' : '' %>>Snack</option>
        </select>
        <div class="form-hint">Choose the best category for your recipe</div>
      </div>

      <div class="form-group">
        <label for="ingredients">Ingredients (comma-separated)</label>
        <textarea
          id="ingredients"
          name="ingredients"
          placeholder="e.g., 2 cups flour, 1 cup sugar, 3 eggs, 1 tsp vanilla extract"
          required
        ><%= typeof body !== 'undefined' ? body.ingredients || '' : '' %></textarea>
        <div class="form-hint">List each ingredient separated by commas. Include quantities!</div>
      </div>

      <div class="form-group">
        <label for="instructions">Instructions</label>
        <textarea
          id="instructions"
          name="instructions"
          placeholder="Step 1: ...&#10;Step 2: ...&#10;Step 3: ..."
          required
        ><%= typeof body !== 'undefined' ? body.instructions || '' : '' %></textarea>
        <div class="form-hint">Write step-by-step instructions. Be as detailed as possible.</div>
      </div>

      <div class="button-group">
        <button type="submit" class="btn-submit">Create Recipe</button>
        <a href="/recipes" class="btn-cancel">Cancel</a>
      </div>
    </form>
  </div>
</body>
</html>
