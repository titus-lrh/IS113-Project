<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= recipe.title %> - Everyday Cooks</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background-color: #f5f5f5;
      color: #333;
    }

    nav {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      padding: 1rem 2rem;
      color: white;
      display: flex;
      justify-content: space-between;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 1.5rem;
    }

    nav a:hover {
      text-decoration: underline;
    }

    .container {
      max-width: 900px;
      margin: 2rem auto;
      padding: 0 1rem;
    }

    .recipe-header {
      background-color: white;
      padding: 2rem;
      border-radius: 0.5rem;
      margin-bottom: 2rem;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    .recipe-header h1 {
      margin-bottom: 1rem;
    }

    .recipe-meta {
      display: flex;
      justify-content: space-between;
      margin: 1rem 0;
      padding: 1rem 0;
      border-top: 1px solid #eee;
      border-bottom: 1px solid #eee;
      flex-wrap: wrap;
    }

    .meta-item {
      flex: 1;
      min-width: 150px;
      padding: 0.5rem;
      text-align: center;
    }

    .meta-item strong {
      display: block;
      color: #667eea;
      font-size: 1.5rem;
    }

    .meta-item small {
      color: #666;
    }

    .recipe-content {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      margin: 2rem 0;
    }

    .section {
      background-color: white;
      padding: 2rem;
      border-radius: 0.5rem;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    .section h2 {
      margin-bottom: 1.5rem;
      color: #333;
      border-bottom: 2px solid #667eea;
      padding-bottom: 0.5rem;
    }

    .ingredients-list {
      list-style: none;
    }

    .ingredients-list li {
      padding: 0.5rem 0;
      border-bottom: 1px solid #eee;
      padding-left: 1.5rem;
      position: relative;
    }

    .ingredients-list li::before {
      content: "•";
      color: #667eea;
      position: absolute;
      left: 0;
    }

    .ingredients-list li:last-child {
      border-bottom: none;
    }

    .instructions {
      line-height: 1.8;
      white-space: pre-wrap;
    }

    .actions {
      display: flex;
      gap: 1rem;
      margin-top: 2rem;
    }

    .btn {
      padding: 0.75rem 1.5rem;
      text-decoration: none;
      border-radius: 0.25rem;
      border: none;
      cursor: pointer;
      font-size: 1rem;
      font-weight: bold;
    }

    .btn-primary {
      background-color: #667eea;
      color: white;
    }

    .btn-danger {
      background-color: #dc3545;
      color: white;
    }

    .btn-secondary {
      background-color: #6c757d;
      color: white;
    }

    .category-badge {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      background-color: #e0e7ff;
      color: #667eea;
      border-radius: 1rem;
      font-size: 0.85rem;
      margin-bottom: 1rem;
    }

    .author-info {
      background-color: white;
      padding: 1.5rem;
      border-radius: 0.5rem;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      margin-bottom: 2rem;
    }

    .author-info p {
      color: #666;
      margin-bottom: 0.5rem;
    }
  </style>
</head>

<body>
  <nav>
    <strong>Everyday Cooks</strong>
    <div>
      <% if (typeof session !== 'undefined' && session.userId) { %>
      <span><%= session.username %></span>
      <a href="/recipes">Recipes</a>
      <a href="/auth/dashboard">Dashboard</a>
      <a href="/auth/logout">Logout</a>
      <% } else { %>
      <a href="/auth/login">Login</a>
      <% } %>
    </div>
  </nav>

  <div class="container">
    <a href="#" onclick="history.back(); return false;" style="color: #667eea; text-decoration: none;">← Back</a>
    <br><br>
    <div class="recipe-header">
  
      <div style="display:flex; justify-content:space-between; align-items:center;">

  <h1><%= recipe.title %></h1>

  <div>


    <span style="color:#f4b400; font-weight:bold;">
      Rating: ⭐ <%= recipe.rating ? recipe.rating.toFixed(1) : 0 %>
      (<%= recipe.ratingCount || 0 %>)
    </span>
    
    <% 
      const hasRated = recipe.ratedUsers &&
        recipe.ratedUsers.some(u => u.toString() === session.userId);
    %>

        <% if (hasRated) { %>
          <p style="color:red;">You have already rated this recipe</p>
        <% } %>

        <% if (!hasRated) { %>

        <% } else { %>

          <p style="color:green;">Thanks for rating!</p>

        <% } %>

    
     <% if (typeof session !== 'undefined' && session.userId) { %>
      <form action="/recipes/<%= recipe._id %>/rate" method="POST" style="margin-top:10px;">

        <div id="stars" style="font-size:28px; cursor:pointer;">
          <span data-value="1">☆</span>
          <span data-value="2">☆</span>
          <span data-value="3">☆</span>
          <span data-value="4">☆</span>
          <span data-value="5">☆</span>
        </div>

        <input type="hidden" name="rating" id="ratingValue">

        <br>

        <button class="btn btn-primary" type="submit">Submit Rating</button>

      </form>

    <% } else { %>

      <p style="font-size:0.8rem; color:#999;">Login to rate</p>

    <% } %>

  </div>

</div>

      <% if (recipe.category) { %>
      <% recipe.category.forEach(subCategory => { %>
      <span class="category-badge"><%= subCategory %></span>
      <% }) %>
      <% } %>

      <p style="color: #666; margin: 1rem 0;">
        <strong>By:</strong> <%= recipe.author.firstName %> <%= recipe.author.lastName %>
      </p>

      <div class="recipe-meta">
        <div class="meta-item">
          <strong><%= recipe.cookingTime %></strong>
          <small>Minutes</small>
        </div>
        <div class="meta-item">
          <strong><%= recipe.servings %></strong>
          <small>Servings</small>
        </div>
        <div class="meta-item">
          <strong><%= recipe.ingredients.length %></strong>
          <small>Ingredients</small>
        </div>
      </div>

      <p style="margin-top: 1rem; color: #999; font-size: 0.9rem;">
        Created: <%= new Date(recipe.createdAt).toLocaleDateString() %>
      </p>
    </div>

    <div class="author-info">
      <h3>About This Recipe</h3>
      <p><%= recipe.description %></p>
    </div>

    <div class="recipe-content">
      <div class="section">
        <h2>Ingredients</h2>
        <ul class="ingredients-list">
          <% recipe.ingredients.forEach(ingredient => { %>
          <li><%= ingredient %></li>
          <% }); %>
        </ul>
      </div>

      <div class="section">
        <h2>Instructions</h2>
        <div class="instructions"><%= recipe.instructions %></div>
      </div>
    </div>

    <% if (typeof session !== 'undefined' && session.userId && recipe.author._id === session.userId) { %>
    <div class="actions">
      <a href="/recipes/<%= recipe._id %>/edit" class="btn btn-primary">Edit Recipe</a>
      <button class="btn btn-danger" onclick="deleteRecipe('<%= recipe._id %>')">Delete Recipe</button>
    </div>
    <% } %>
  </div>

  <script>
    function deleteRecipe(id) {
      if (confirm('Are you sure you want to delete this recipe?')) {
        fetch(`/recipes/${id}/delete`, {
            method: 'POST'
          })
          .then(res => res.json())
          .then(data => {
            alert(data.msg);
            window.location.href = '/recipes';
          })
          .catch(err => console.error(err));
      }
    }
  </script>

  <script>
  const stars = document.querySelectorAll('#stars span');
  const ratingInput = document.getElementById('ratingValue');

  stars.forEach(star => {
    star.addEventListener('mouseover', () => {
      const val = star.getAttribute('data-value');
      highlightStars(val);
    });

    star.addEventListener('click', () => {
      const val = star.getAttribute('data-value');
      ratingInput.value = val;
    });
  });

  function highlightStars(val) {
    stars.forEach(star => {
      if (star.getAttribute('data-value') <= val) {
        star.textContent = "⭐";
      } else {
        star.textContent = "☆";
      }
    });
  }
  </script>

  
</body>

</html>