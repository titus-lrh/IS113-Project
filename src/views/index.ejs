<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home - Recipe App</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background: white;
      margin: 0;
    }

     nav {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      padding: 1rem 2rem;
      color: white;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    nav a {
      color: white;
      text-decoration: underline;
      margin-left: 1.5rem;
    }

  </style>
</head>
<body>
  <nav>
    <strong>Simple Joy</strong>
    <div>
      <a href="/auth/logout">Sign In</a>
    </div>
  </nav>
  <div class="container">
    <h2>Recipes</h2>

    <% if (typeof category !== 'undefined' && category) { %>
      <p>Showing recipes in category: <strong><%= category %></strong></p>
    <% } %>

    <% if (typeof recipes !== 'undefined' && recipes.length > 0) { %>
      <div class="recipes-grid">
        <% recipes.forEach(recipe => { %>
          <div class="recipe-card">
            <div class="recipe-header">
              <h3><%= recipe.title %></h3>
              <div class="recipe-meta">
                By <%= recipe.author.username %>
              </div>
            </div>

            <div class="recipe-body">
              <p><%= recipe.description.substring(0, 100) %>...</p>

              <% if (recipe.category) { %>
                <span class="category-badge"><%= recipe.category %></span>
              <% } %>

              <div class="recipe-info">
                <div class="info-item">
                  <strong><%= recipe.cookingTime %></strong>
                  <small>minutes</small>
                </div>
                <div class="info-item">
                  <strong><%= recipe.servings %></strong>
                  <small>servings</small>
                </div>
                <div class="info-item">
                  <strong><%= recipe.ingredients.length %></strong>
                  <small>ingredients</small>
                </div>
              </div>
            </div>

            <div class="recipe-footer">
              <a href="/recipes/<%= recipe._id %>">View</a>
              <% if (typeof session !== 'undefined' && session.userId && recipe.author._id == session.userId) { %>
                <a href="/recipes/<%= recipe._id %>/edit">Edit</a>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <h2>No recipes found</h2>
      </div>
    <% } %>
  </div>
</body>
</html>
