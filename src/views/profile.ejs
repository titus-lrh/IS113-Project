<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= user.username %>'s Profile — Everyday Cooks</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="nav">
    <a href="/" class="nav__brand">Everyday Cooks</a>
    <div class="nav__links">
      <a href="/recipes" class="nav__link">Recipes</a>
      <a href="/auth/dashboard" class="nav__link">Dashboard</a>
      <a href="/auth/logout" class="nav__link">Logout</a>
    </div>
  </nav>

  <div class="container container--xl">
    <div class="profile-hero">
      <div class="profile-hero__name"><%= user.username %></div>
      <div class="profile-hero__meta">
        <span>✉️ <%= user.email %></span>
        <span>📅 Joined <%= user.createdAt.toDateString() %></span>
      </div>
      <% if (user.bio) { %>
        <p class="profile-hero__bio"><%= user.bio %></p>
      <% } %>
    </div>

    <div class="actions">
      <button onclick="window.location.href='/profile/edit/<%= user._id %>'" class="btn btn--secondary">
        ✏️ Edit Profile
      </button>
      <button onclick="window.location.href='/profile/delete/<%= user._id %>'" class="btn btn--danger">
        🗑 Delete Account
      </button>
    </div>
  </div>
</body>
</html>
