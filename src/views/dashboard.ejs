<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Recipe App</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background-color: #f5f5f5;
      color: #333;
    }

    nav {
      background-color: #333;
      padding: 1rem 2rem;
      color: white;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 1.5rem;
    }

    nav a:hover {
      text-decoration: underline;
    }

    .container {
      max-width: 1000px;
      margin: 2rem auto;
      padding: 0 1rem;
    }

    h1 {
      margin-bottom: 1.5rem;
    }

    .welcome-card {
      background-color: white;
      padding: 2rem;
      border-radius: 0.5rem;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      margin-bottom: 2rem;
    }

    .actions {
      display: flex;
      gap: 1rem;
      margin-top: 1.5rem;
    }

    .actions a {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background-color: #333;
      color: white;
      text-decoration: none;
      border-radius: 0.25rem;
    }

    .actions a:hover {
      background-color: #555;
    }

    .quick-links {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
      margin-top: 2rem;
    }

    .quick-link-card {
      background-color: white;
      padding: 1.5rem;
      border-radius: 0.5rem;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      text-align: center;
    }

    .quick-link-card h3 {
      margin-bottom: 1rem;
    }

    .quick-link-card a {
      display: inline-block;
      padding: 0.5rem 1rem;
      background-color: #667eea;
      color: white;
      text-decoration: none;
      border-radius: 0.25rem;
    }

    .quick-link-card a:hover {
      background-color: #5568d3;
    }
  </style>
</head>
<body>
  <nav>
    <strong>Recipe App</strong>
    <div>
      <span>Welcome, <%= user.username %></span>
      <a href="/auth/logout">Logout</a>
    </div>
  </nav>

  <div class="container">
    <h1>Dashboard</h1>

    <div class="welcome-card">
      <h2>Welcome back, <%= user.username %>!</h2>
      <p>Manage your recipes and explore the community</p>
      <div class="actions">
        <a href="/recipes/new">Create New Recipe</a>
        <a href="/recipes">Browse All Recipes</a>
      </div>
    </div>

    <div class="quick-links">
      <div class="quick-link-card">
        <h3>📝 My Recipes</h3>
        <p>View and manage your recipes</p>
        <a href="/recipes/my-recipes">View Recipes</a>
      </div>

      <div class="quick-link-card">
        <h3>🔍 Browse Recipes</h3>
        <p>Discover recipes from the community</p>
        <a href="/recipes">Browse</a>
      </div>

      <div class="quick-link-card">
        <h3>➕ Create Recipe</h3>
        <p>Share your favorite recipes</p>
        <a href="/recipes/new">Create</a>
      </div>
    </div>
  </div>
</body>
</html>
